# Runtime
NODE_ENV=production
PORT=5000
API_PORT=5000
JSON_BODY_LIMIT=25mb

# PostgreSQL
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=Dashboard
DB_USER=postgres
DB_PASSWORD=your-password
DB_SSL=true

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google Apps Script
APPSCRIPT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
APPS_SCRIPT_TIMEOUT=120000

# OCR container
PYTHON_OCR_URL=http://ocr:8001
open_router_key=your-openrouter-key
OPENROUTER_MODEL_OCR=openai/gpt-4o-mini
appscript_key=${APPSCRIPT_URL}
