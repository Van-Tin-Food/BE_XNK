# =============================================================
# Mẫu biến môi trường cho BE_XNK.
# Copy thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# Chi tiết từng biến: xem DEPLOY.md mục 4.
# =============================================================

# ---------- Node API ----------
NODE_ENV=production
PORT=5000
JSON_BODY_LIMIT=25mb

# ---------- Google Apps Script ----------
APPSCRIPT_URL=https://script.google.com/macros/s/<deployment-id>/exec
APPS_SCRIPT_TIMEOUT=120000

# ---------- OCR (Python) ----------
# Tên biến viết thường là đúng theo code trong python/ocr_server.py
open_router_key=sk-or-v1-<openrouter-api-key>
OPENROUTER_MODEL_OCR=openai/gpt-4o-mini
appscript_key=https://script.google.com/macros/s/<deployment-id>/exec

# Địa chỉ Node dùng để gọi sang service OCR.
# - Chạy local (2 tiến trình trên cùng máy): http://127.0.0.1:8001
# - Chạy Docker Compose (2 container):       http://ocr:8001
PYTHON_OCR_URL=http://ocr:8001

# Địa chỉ service OCR lắng nghe.
# Trong Docker bắt buộc là 0.0.0.0, nếu để 127.0.0.1 thì container api không gọi được.
PYTHON_OCR_HOST=0.0.0.0
PYTHON_OCR_PORT=8001

# ---------- JWT ----------
# Sinh khoá bằng: openssl rand -base64 48
JWT_SECRET=<chuoi-ngau-nhien-du-manh>
JWT_EXPIRES_IN=1d

# ---------- PostgreSQL ----------
# Dùng dịch vụ managed (Render/Supabase/RDS...) thì thường phải đặt DB_SSL=true.
DB_HOST=<db-host>
DB_PORT=5432
DB_NAME=<db-name>
DB_USER=<db-user>
DB_PASSWORD=<db-password>
DB_SSL=false
