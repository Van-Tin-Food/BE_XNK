# Service OCR: Python + Tesseract. Tách riêng khỏi image Node vì Tesseract và
# các thư viện xử lý ảnh nặng, và vì OCR cần nhiều RAM hơn hẳn phần API.
FROM python:3.12-slim-bookworm

# tesseract-ocr-vie cần cho chứng từ tiếng Việt: ocr_server.py tự dùng "eng+vie"
# nếu phát hiện gói vie, ngược lại lùi về "eng".
#
# Retry loop: CDN Fastly của deb.debian.org thỉnh thoảng trả 403 forbidden khi
# apt-get update bắn đồng thời nhiều request (main/updates/security) - đã xác
# nhận qua test thật trên VM300 (request đơn lẻ luôn 200, apt-get update thì
# hay dính 403). Retry là cách chuẩn cho lỗi CDN thoáng qua này.
RUN for i in 1 2 3 4 5; do \
        apt-get update && \
        apt-get install -y --no-install-recommends \
            tesseract-ocr \
            tesseract-ocr-vie && break; \
        echo "apt-get failed (lan $i), thu lai sau 5s..."; sleep 5; \
    done && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY python/requirements.txt ./python/requirements.txt
RUN pip install --no-cache-dir -r python/requirements.txt

COPY python ./python

RUN useradd --create-home --uid 1001 ocr
USER ocr

# PYTHON_OCR_HOST bắt buộc là 0.0.0.0. Mặc định trong code là 127.0.0.1, khi đó
# container api sẽ không gọi sang được.
ENV PYTHON_OCR_HOST=0.0.0.0 \
    PYTHON_OCR_PORT=8001 \
    PYTHONUNBUFFERED=1

EXPOSE 8001

# ocr_server.py có sẵn GET /health trả 200 JSON, nên kiểm tra được ở mức HTTP
# thật thay vì chỉ dò cổng TCP: cách này phát hiện được cả trường hợp tiến trình
# treo mà cổng vẫn mở.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health', timeout=4)"

CMD ["python", "python/ocr_server.py"]
