# Service OCR: Python + Tesseract. Tách riêng khỏi image Node vì Tesseract và
# các thư viện xử lý ảnh nặng, và vì OCR cần nhiều RAM hơn hẳn phần API.
FROM python:3.12-slim-bookworm

# tesseract-ocr-vie cần cho chứng từ tiếng Việt: ocr_server.py tự dùng "eng+vie"
# nếu phát hiện gói vie, ngược lại lùi về "eng".
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        tesseract-ocr \
        tesseract-ocr-vie && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY python/requirements.txt ./python/requirements.txt
RUN pip install --no-cache-dir -r python/requirements.txt

COPY python ./python

RUN useradd --create-home --uid 1001 ocr
USER ocr

# PYTHON_OCR_HOST bắt buộc là 0.0.0.0. Mặc định trong code là 127.0.0.1, khi đó
# container api sẽ không gọi sang được.
ENV PYTHON_OCR_HOST=0.0.0.0 \
    PYTHON_OCR_PORT=8001 \
    PYTHONUNBUFFERED=1

EXPOSE 8001

# Kiểm tra ở mức TCP: ocr_server.py chỉ định nghĩa do_POST nên mọi GET đều trả
# 501, dùng HTTP client sẽ phải bắt HTTPError rồi coi đó là "sống" - vòng vo và
# dễ sai. Mở được kết nối tới cổng là đủ để biết tiến trình còn nhận request.
# Hạn chế: không phát hiện được trường hợp tiến trình treo mà cổng vẫn mở.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import socket; socket.create_connection(('127.0.0.1', 8001), 4).close()"

CMD ["python", "python/ocr_server.py"]
